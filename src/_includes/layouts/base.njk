<!doctype html>
{% set copy = site.copy[language] %}
{% set loc = null %}
{% for l in site.locales %}{% if l.code == language %}{% set loc = l %}{% endif %}{% endfor %}
{% if pageType == 'legal' %}
  {% set title = legalPageTitle %}
  {% set description = legalPageDescription %}
{% else %}
  {% set title = copy.homeTitle %}
  {% set description = copy.homeDescription %}
{% endif %}
<html lang="{{ loc.htmlLang }}" dir="{{ loc.dir or 'ltr' }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title }}</title>
  <meta name="description" content="{{ description }}">
  {% if pageType == 'legal' %}<meta name="robots" content="noindex, nofollow">{% endif %}
  <link rel="canonical" href="{{ site.origin }}{{ canonicalPath }}">
  {% if pageType == 'legal' %}
  <link rel="alternate" hreflang="ko" href="{{ site.origin }}{{ canonicalPath }}">
  <link rel="alternate" hreflang="x-default" href="{{ site.origin }}{{ canonicalPath }}">
  {% else %}
    {% for item in site.locales %}
  <link rel="alternate" hreflang="{{ item.htmlLang }}" href="{{ site.origin }}{{ site.homePaths[item.code] }}">
    {% endfor %}
  <link rel="alternate" hreflang="x-default" href="{{ site.origin }}/">
  {% endif %}
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:title" content="{{ title }}">
  <meta property="og:description" content="{{ description }}">
  <meta property="og:url" content="{{ site.origin }}{{ canonicalPath }}">
  <meta name="twitter:card" content="summary">
  <meta name="twitter:title" content="{{ title }}">
  <meta name="twitter:description" content="{{ description }}">
{% include "head-icons.njk" %}
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <a class="skip-link" href="#main-content">{{ copy.skipLink }}</a>
  <header class="container site-header">
    <div class="top-bar">
      {% set menuItems = [] %}
      {% for l in site.locales %}{% set menuItems = (menuItems.push({ code: l.code, htmlLang: l.htmlLang, label: l.label, href: site.homePaths[l.code] }), menuItems) %}{% endfor %}
      {% set menuCurrent = language %}{% set menuLabel = copy.languageLabel %}
      {% include "lang-menu.njk" %}
      {% if pageType != 'home' %}<a class="brand-link" href="{{ site.homePaths[language] }}">{{ site.name }}</a>{% endif %}
    </div>
    {% if pageType == 'home' %}
    <div class="brand">
      <h1><a href="{{ site.homePaths[language] }}">{{ site.name }}</a></h1>
      <p class="subtitle">{{ copy.subtitle }}</p>
    </div>
    {% else %}
    <div class="header-row">
      <h1>{{ legalPageTitle }}</h1>
      <span class="language-note">한국어 원문</span>
    </div>
    {% endif %}
  </header>
  {{ content | safe }}
  <footer class="container footer">
    <nav class="footer-links" aria-label="{{ copy.footerLabel }}">
      <a href="{{ site.homePaths[language] }}">{{ copy.homeLink }}</a>
      <a href="https://x.com/PDF_Studio" target="_blank" rel="noopener noreferrer">{{ copy.xChannel }}</a>
    </nav>
    <p>© 2026 {{ site.name }}</p>
  </footer>
  <script src="/site.js" defer></script>
</body>
</html>
