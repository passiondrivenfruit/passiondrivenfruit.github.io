<!doctype html>
{% set home = site.homePaths[doc.lang] or "/" %}
<html lang="{{ doc.lang }}" dir="{{ doc.dir }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ doc.title }}</title>
  <meta name="description" content="{{ doc.title }}">
  {% if doc.draft %}<meta name="robots" content="noindex, nofollow">{% endif %}
  <link rel="canonical" href="{{ doc.url }}">
  {% for alt in doc.alternates %}
  <link rel="alternate" hreflang="{{ alt.lang }}" href="{{ site.origin }}{{ alt.href }}">
  {% endfor %}
  <link rel="alternate" hreflang="x-default" href="{{ site.origin }}{{ doc.alternates[0].href }}">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:title" content="{{ doc.title }}">
  <meta property="og:description" content="{{ doc.title }}">
  <meta property="og:url" content="{{ doc.url }}">
{% include "head-icons.njk" %}
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <a class="skip-link" href="#main-content">{{ doc.title }}</a>
  <header class="container site-header">
    <div class="top-bar">
      {% set menuItems = [] %}
      {% for alt in doc.alternates %}{% set menuItems = (menuItems.push({ code: alt.lang, htmlLang: alt.lang, label: alt.label, href: alt.href }), menuItems) %}{% endfor %}
      {% set menuCurrent = doc.lang %}{% set menuLabel = doc.ui.languages %}
      {% include "lang-menu.njk" %}
      <a class="brand-link" href="{{ home }}">{{ site.name }}</a>
    </div>
    <div class="header-row">
      <h1>{{ doc.title }}</h1>
    </div>
  </header>
  <main id="main-content" class="container policy legal-document">
    {% if doc.draft %}<p class="draft-notice">{{ doc.ui.draft }}</p>{% endif %}
    {% for line in doc.meta %}<p class="legal-meta">{{ line }}</p>{% endfor %}
    {% for section in doc.sections %}
    <h2>{{ section.heading }}</h2>
    {% for paragraph in section.paragraphs %}<p>{{ paragraph }}</p>{% endfor %}
    {% endfor %}
  </main>
  <footer class="container footer">
    <nav class="footer-links" aria-label="{{ doc.ui.home }}">
      <a href="{{ home }}">{{ doc.ui.home }}</a>
      <a href="https://x.com/PDF_Studio" target="_blank" rel="noopener noreferrer">X</a>
    </nav>
    <p>© 2026 {{ site.name }}</p>
  </footer>
  <script src="/site.js" defer></script>
</body>
</html>
