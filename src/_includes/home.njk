{% set copy = site.copy[language] %}
{% set gamePaths = site.paths.game %}
<main id="main-content" class="container">
  <section aria-labelledby="about-heading">
    <h2 id="about-heading">{{ copy.aboutHeading }}</h2>
    <p>{{ copy.about }}</p>
  </section>

  <section aria-labelledby="games-heading">
    <h2 id="games-heading">{{ copy.gamesHeading }}</h2>
    <div class="game-list">
      <article class="game-item">
        <a class="game-icon" href="{{ gamePaths[language] }}" aria-label="{{ copy.gameTitle }}">
          <img src="/assets/ico/minesweeper.webp" alt="" width="96" height="96" loading="lazy" decoding="async">
        </a>
        <div class="game-info">
          <h3><a href="{{ gamePaths[language] }}">{{ copy.gameTitle }}</a></h3>
          <p class="game-desc">{{ copy.gameDescription }}</p>
        </div>
        <div class="game-platforms">
          <span>{{ copy.available }}</span>
          <a href="{{ site.googlePlay }}" target="_blank" rel="noopener noreferrer" aria-label="{{ copy.download }}">
            <img src="/assets/ico/android.webp" alt="" width="32" height="32" loading="lazy" decoding="async">
          </a>
        </div>
      </article>
    </div>
  </section>

  <section aria-labelledby="contact-heading">
    <h2 id="contact-heading">{{ copy.contactHeading }}</h2>
    <p>{{ copy.contact }}<br><a href="mailto:{{ site.email }}">{{ site.email }}</a></p>
  </section>
</main>
